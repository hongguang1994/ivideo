# 复制为 .env 并按需修改（docker compose 会自动读取）。

# Docker Compose 环境变量。后端业务配置见 data/server/conf.yaml；网盘凭据由设置页存入 MySQL。

# MySQL 初始化密码。请在首次部署前改成自己的强密码；已有数据卷时不会自动修改旧密码。
MYSQL_ROOT_PASSWORD=change-me

# 后端连接 MySQL 的 DSN。Docker 内使用 mysql 服务名，密码应与上方保持一致。
DB_DSN=root:change-me@tcp(mysql:3306)/ivideo?charset=utf8mb4&parseTime=true&loc=Local
